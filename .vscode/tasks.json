{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "GCC Build",
			"type": "shell",
			"command": "g++",
			"args": [
				"-xc++",
				"-std=c++23",
				"-I","${workspaceFolder}/src",
				"-s","${fileDirname}/${fileBasename}",
				"-o","${fileDirname}/${fileBasenameNoExtension}.exe",
			]
		},{
			"label": "GDB Build",
			"type": "shell",
			"command": "g++",
			"args": [
				"-xc++",
				"-std=c++23",
				"-I","${workspaceFolder}/src",
				"-g","${fileDirname}/${fileBasename}",
				"-o","${fileDirname}/${fileBasenameNoExtension}.exe",
				"-lstdc++exp"
			]
		},{
			"label": "GDB Expr:Reflection",
			"type": "shell",
			"command": "g++",
			"args": [
				"-xc++",
				"-std=c++26",
				"-freflection",
				"-I","${workspaceFolder}/src",
				"-g","${fileDirname}/${fileBasename}",
				"-o","${fileDirname}/${fileBasenameNoExtension}.exe",
			]
		},{
			"label": "WSL GCC Build",
			"type": "shell",
			"command": "g++-14",
			"args": [
				"-xc++",
				"-std=c++23",
				"-I","${workspaceFolder}/src",
				"-s","${fileDirname}/${fileBasename}",
				"-o","${fileDirname}/${fileBasenameNoExtension}.exe",
			]
		},{
			"label": "WSL GDB Build",
			"type": "shell",
			"command": "g++-14",
			"args": [
				"-xc++",
				"-std=c++23",
				"-I","${workspaceFolder}/src",
				"-g","${fileDirname}/${fileBasename}",
				"-o","${fileDirname}/${fileBasenameNoExtension}.exe",
			]
		},{
			"label": "GCC Module",
			"type": "shell",
			"command": "g++",
			"args": [
				"-xc++",
				"-std=c++23",
				"-fmodules-ts",
				"-I","${workspaceFolder}/src",
				"-s","${fileDirname}/${fileBasename}",
				"-c","-o","${fileDirname}/${fileBasenameNoExtension}.pcm",
			]
		},{
			"label": "Doxygen",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-File",
				"${workspaceRoot}/.vscode/doxybuild.ps1"
			]
		}
	],
	"problemMatcher":
	[
		{
			"owner": "syntax",
			"fileLocation": [
				"autoDetect",
				"${workspaceRoot}"
			],
			"pattern": {
				"regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error|note):\\s+(.*)$",
				"file": 1,
				"line": 2,
				"column": 3,
				"severity": 4,
				"message": 5
			}
		},
		{
			"owner": "compiler",
			"fileLocation": [
				"autoDetect",
				"${workspaceRoot}"
			],
			"pattern": {
				"regexp": "^(.+\\.exe):\\s*(warning|error):\\s*(.*)$",
				"file": 1,
				"severity": 2,
				"message": 3
			}
		}
	]
	
}